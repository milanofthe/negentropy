#!/bin/sh
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
[ -f "$root/negentropy.toml" ] || exit 0
negentropy=$(command -v negentropy || command -v "$HOME/.local/bin/negentropy") || {
	echo "negentropy is not installed or not on PATH: pipx install git+https://github.com/milanofthe/negentropy" >&2
	exit 2
}
"$negentropy" check >&2 || exit 2
