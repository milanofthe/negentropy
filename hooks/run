#!/bin/sh
name=$1
shift
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

if [ -f "$root/negentropy.toml" ]; then
	case "$name" in
	pre-commit) negentropy check || exit 1 ;;
	commit-msg) negentropy message "$1" || exit 1 ;;
	esac
fi

own="$(git rev-parse --git-common-dir)/hooks/$name"
if [ -x "$own" ]; then
	exec "$own" "$@"
fi
